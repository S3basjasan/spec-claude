APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Contraseña de los usuarios de prueba (solo desarrollo)
SEED_PASSWORD=password-de-prueba

# Gestión de Personal (feature 005): en false se detiene el alta y la edición de fichas (rollback).
GESTION_PERSONAL_ESCRITURA_HABILITADA=true

# GP-02: en false se detiene el registro de ingresos (503).
GESTION_PERSONAL_INGRESOS_HABILITADOS=true
DB_BUSY_TIMEOUT=5000

# Gestión de Personal: documentos (014) y exportación de ficha (015)
GESTION_PERSONAL_DOCUMENTOS_HABILITADOS=true
DOCUMENTOS_DISCO=local
GESTION_PERSONAL_EXPORTACION_HABILITADA=true
GESTION_PERSONAL_POLITICAS_HABILITADO=true

# Adecuación a puesto futuro (020): conocimientos con grado A-D (aún no existen en Estructura) y lectura de experiencia desde Personal
DESARROLLO_ADECUACION_CONOCIMIENTOS_CON_GRADO=false
DESARROLLO_ADECUACION_EXPERIENCIA_DISPONIBLE=true
